{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ronininc/kingmaker-brain-library/main/schema/library.schema.json",
  "title": "Kingmaker Brain Library",
  "type": "object",
  "required": [
    "schema",
    "devices",
    "classes",
    "models"
  ],
  "properties": {
    "schema": {
      "const": "kingmaker.brain-library/1"
    },
    "repo": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    },
    "source": {
      "type": [
        "string",
        "null"
      ]
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "chip",
          "ramGb",
          "class"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "chip": {
            "type": "string"
          },
          "ramGb": {
            "type": "integer"
          },
          "bandwidthGBs": {
            "type": [
              "number",
              "null"
            ]
          },
          "macs": {
            "type": "string"
          },
          "class": {
            "type": "integer"
          },
          "pack": {
            "type": "string"
          }
        }
      }
    },
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "class",
          "roles",
          "maxResidentGb",
          "context",
          "concurrent",
          "status"
        ],
        "properties": {
          "class": {
            "type": "integer"
          },
          "pack": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "roles": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "maxResidentGb": {
            "type": "number"
          },
          "context": {
            "type": "integer"
          },
          "concurrent": {
            "type": "integer"
          },
          "voice": {
            "enum": [
              "on",
              "off"
            ]
          },
          "pictures": {
            "type": "boolean"
          },
          "downloadGb": {
            "type": "number"
          },
          "basis": {
            "type": "string"
          },
          "status": {
            "enum": [
              "measured",
              "estimate"
            ]
          },
          "measuredOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tag",
          "slug",
          "status"
        ],
        "properties": {
          "tag": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "base": {
            "type": [
              "string",
              "null"
            ]
          },
          "license": {
            "type": [
              "string",
              "null"
            ]
          },
          "kind": {
            "type": "string"
          },
          "redistributable": {
            "type": "boolean"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "capabilities": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "status": {
            "enum": [
              "pick",
              "option",
              "retired"
            ]
          },
          "picks": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "class": {
                  "type": "integer"
                },
                "role": {
                  "type": "string"
                }
              }
            }
          },
          "bench": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "weights": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "release": {
                "type": "string"
              },
              "gguf": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              },
              "size": {
                "type": "integer"
              },
              "modelfile": {
                "type": "string"
              },
              "parts": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "size",
                    "sha256"
                  ],
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "size": {
                      "type": "integer"
                    },
                    "sha256": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "applications": {
      "type": "array",
      "description": "Reviewed optional applications downloaded and verified by Kingmaker.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "version", "kind", "license", "source", "sourceCommit", "release", "asset", "size", "sha256", "root", "python", "install", "use"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,40}$" },
          "name": { "type": "string" },
          "version": { "type": "string" },
          "kind": { "const": "local-web-app" },
          "summary": { "type": "string" },
          "license": { "type": "string" },
          "source": { "type": "string", "pattern": "^https://github\\.com/" },
          "sourceCommit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
          "release": { "type": "string" },
          "asset": { "type": "string" },
          "size": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "root": { "type": "string" },
          "python": { "type": "string" },
          "install": { "type": "array", "items": { "type": "string" } },
          "use": {
            "type": "object",
            "required": ["command", "args", "url"],
            "properties": {
              "command": { "const": "sh" },
              "args": { "type": "array", "items": { "type": "string" } },
              "url": { "type": "string", "pattern": "^http://127\\.0\\.0\\.1:" }
            }
          },
          "credentials": { "type": "string" }
        }
      }
    },
    "bench": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bigOptions": {
      "type": "array",
      "description": "Listed for Macs bigger than any profile class; never picked, never measured here, weights linked upstream.",
      "items": {
        "type": "object",
        "required": [
          "tag",
          "license",
          "from",
          "forRamGb",
          "files",
          "runtime",
          "status",
          "basis"
        ],
        "properties": {
          "tag": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "gguf": {
            "type": "string"
          },
          "forRamGb": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "quant": {
                  "type": "string"
                },
                "gb": {
                  "type": "number"
                }
              }
            }
          },
          "runtime": {
            "type": "string"
          },
          "status": {
            "const": "option"
          },
          "basis": {
            "const": "estimate"
          },
          "redistributable": {
            "const": false
          },
          "links": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
